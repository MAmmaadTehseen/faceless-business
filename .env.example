# Model provider (default anthropic; no automatic provider fallback)
LLM_PROVIDER=anthropic
LUNAROUTE_API_KEY=
# Anthropic-compatible gateway root; /v1 also accepted
LUNAROUTE_BASE_URL=https://gw.lunaroute.com
# Optional overrides for either provider; leave blank to use provider defaults
LLM_MODEL_SCRIPT=
LLM_MODEL_ARTICLE=
LLM_MODEL_QA=
LLM_MODEL_VISION=
LLM_MODEL_REPLY=
LLM_MODEL_IDEATE=
LLM_MODEL_SHORT_DAILY=
LLM_MODEL_RECAP=
LLM_MODEL_REVIEW=
LLM_MODEL_OPTIMIZE=
LLM_MODEL_HOOK=
LLM_MAX_CALLS_PER_CLIENT=100

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Database. Leave SUPABASE_URL empty to use the local SQLite file data/local.db (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stock footage
PIXABAY_API_KEY=
PEXELS_API_KEY=

# YouTube (scripts/youtube_auth.py prints the refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Meta (Instagram + Facebook). scripts/meta_token.py explains how to get a long-lived token.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# Instagram API with Instagram Login (per channel): IG_ACCESS_TOKEN_<KEY> (60-day user token, auto-refreshed by sync) + META_IG_USER_ID_<KEY>
IG_ACCESS_TOKEN=
IG_APP_ID=

# Optional
PEXELS_RATE_LIMIT_PER_HOUR=200
OUT_DIR=out
