# Supabase (service role key: server-side only, never exposed to the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Dashboard auth (single user)
DASHBOARD_PASSWORD=change-me
DASHBOARD_SECRET=long-random-string-used-to-sign-the-session-cookie
# Optional read-only login for API reviewers (3-day session, cannot send or change anything)
DASHBOARD_REVIEWER_PASSWORD=

# YouTube Data API (OAuth refresh-token flow) for replying to comments
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Meta Graph API token (Instagram + Facebook comment replies / likes)
META_ACCESS_TOKEN=
